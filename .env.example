# Copia este archivo a .env y rellena los valores (nunca subas .env a git)

# Email para los certificados HTTPS de Let's Encrypt
ACME_EMAIL=tu-email@tuagencia.com

# Subdominio donde vivirá el panel de n8n (crea un registro DNS tipo A apuntando al servidor)
N8N_DOMAIN=n8n.tuagencia.com

# Clave para cifrar las credenciales guardadas en n8n. Genérala con: openssl rand -hex 32
N8N_ENCRYPTION_KEY=cambia-esto

TZ=Europe/Madrid
